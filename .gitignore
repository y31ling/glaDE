# ==================== V0.4 ====================
# stray Windows-path artifact (accidental)
C:/
/C:/

# user working files live in InputFiles/; ship the folder empty
InputFiles/*
!InputFiles/.gitkeep

# keep V0.4 assets the blanket *.dat / *.png rules would otherwise drop
!core/examples/*.dat
!source/icon/Explorer.png
!source/icon/Template.png

# session handoff note for a future Claude Code (local only, not shipped)
memory.md

# Rhongomyniad table-interpolation caches (auto-built on first use).
# EXCEPTION: the acnfw CSE table is verbatim source data extracted from
# glafic's app_cnfw.c (not re-buildable at runtime) and ships in git.
Rhongomyniad/rhongomyniad/_tab_cache/*
!Rhongomyniad/rhongomyniad/_tab_cache/acnfw_cse_v1.npz
# one-off tensorization verification artifact (not referenced by any test)
Rhongomyniad/tests/_tensorize_ref.npz

# ==================== V0.5.1 cleanup ====================
